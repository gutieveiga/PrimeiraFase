programa {
  funcao inicio() {
    //entendimento do problema
      //calcular o horario de retorno do recreio
    //ifos e variaveis
    inteiro hora, minuto
    //entrada de dados
    escreva("Hora do começo: ")
    leia(hora)
    escreva("Minuto do começo: ")
    leia(minuto)
    //processamento
    minuto = minuto + 20
    //saida    
    escreva("Recreio termina ")
    escreva(hora)
    escreva(":")
    escreva(minuto)
    //escreva("\nO que acontece com quem chega depois do horario? ")
  }
}
