programa {
  funcao inicio() {
    //Peça ao usuário que insira um número de 1 a 7 e, em seguida, 
    //mostre o dia da semana correspondente (por exemplo, 1 = Domingo, 2 = Segunda, etc.)
    inteiro dia

    escreva("Digite um numero: ")
    leia(dia)

    se(dia == 1){
      escreva("Segunda")
    }
    se(dia == 2){
      escreva("Terça")
    }
    se(dia == 3){
      escreva("Quarta")
    }
    se(dia == 4){
      escreva("Quinta")
    }
    se(dia == 5){
      escreva("Sexta")
    }
    se(dia == 6){
      escreva("Sábado")
    }
    se(dia == 7){
      escreva("Domingo")
    }


  }
}
