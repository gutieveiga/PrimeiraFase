programa {
  funcao inicio() {
    //entendimento do problema
     //calcular o valor de vale trocas, considerando preço e quantidade
    //infos e variaveis
    real preco, valeTroca
    inteiro quantidade
    //entrada de dados
   escreva("Preço do calçado: R$")
   leia(preco)
   escreva("Quantidade de calçados: ")
   leia(quantidade)
    //processamento
    valeTroca = preco * quantidade
   //saidas
   escreva("Valor de vale troca: ")
   escreva(valeTroca)

  }
}
